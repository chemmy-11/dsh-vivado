+def _job_state(record: dict) -> tuple[str, int | None]:
+    """判定作业状态 → ``(status, exit_code)``，status ∈ running/finished/failed/unknown。
+
+    判据顺序（从最权威到兜底）：
+    1. ``.rc`` 文件（包装器在 Vivado 返回后立刻写，跨 server 重启仍然有效）；
+    2. sidecar JSON 里已落地的 ``exit_code``；
+    3. PID 存活（ctypes，无新依赖）；
+    4. schtasks 路径偶尔拿不到 PID（计划任务服务起进程，句柄不在我们手里）：
+       退回「计划任务定义是否还在」当存活判据；
+    5. 进程已退出但两条路都拿不到退出码 → ``unknown``（不猜成功）。
+    """
+    code = _read_rc(record.get("rc_path") or "")
+    if code is None and record.get("exit_code") is not None:
+        try:
+            code = int(record["exit_code"])
+        except (TypeError, ValueError):
+            code = None
+    if code is not None:
+        return ("finished" if code == 0 else "failed"), code
+
+    try:
+        pid = int(record.get("pid") or 0)
+    except (TypeError, ValueError):
+        pid = 0
+    if pid > 0:
+        alive, os_code = _process_state(pid)
+        if alive:
+            return "running", None
+        if os_code is not None:
+            return ("finished" if os_code == 0 else "failed"), os_code
+        return "unknown", None
+
+    # 没有 PID：只有 schtasks 路径会这样，用任务定义存在性判活
+    task_name = record.get("task_name") or ""
+    if record.get("launcher") == "schtasks" and task_name:
+        return ("running" if _task_exists(task_name) else "unknown"), None
+    return "unknown", None
+
