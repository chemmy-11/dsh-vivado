+def _elapsed_seconds(record: dict) -> float:
+    """从 started_at 算到 finished_at（未结束则算到此刻）的秒数。"""
+    try:
+        started = datetime.datetime.fromisoformat(record.get("started_at") or "")
+    except (TypeError, ValueError):
+        return 0.0
+    finished_raw = record.get("finished_at")
+    try:
+        end = (
+            datetime.datetime.fromisoformat(finished_raw)
+            if finished_raw
+            else datetime.datetime.now()
+        )
+    except (TypeError, ValueError):
+        end = datetime.datetime.now()
+    return max(0.0, (end - started).total_seconds())
+
+
+def _last_log_line(record: dict) -> str:
