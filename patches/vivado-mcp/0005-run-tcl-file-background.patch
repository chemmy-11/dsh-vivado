+# --------------------------------------------------------------------------- #
+#  脱离进程树的 batch 作业（script_path / background / job_id）
+# --------------------------------------------------------------------------- #
+#
+# 为什么必须是「脱离进程树」而不是 asyncio 子进程：
+#   会话内的命令超时只是 MCP 停止等待，Vivado 侧还在跑，且会话被在途命令占住
+#   （坑 #77：超时后下一条命令直接被拒「上一条命令仍在执行」）。长脚本要跑几十分钟，
+#   而 MCP server 会随回合结束 / ^C / 重连退出——子进程一挂构建就没了。
+#   所以：写一个 ASCII 包装 .cmd → cmd.exe 以 DETACHED_PROCESS 启动 → Vivado batch
+#   的输出全部落文件 → 作业状态写 sidecar JSON（server 重启后仍能按 job_id 查回）。
+#
+# 批处理的硬约束（2026-10-25 实测踩过）：包装器里调用另一个 .bat **必须加 call**，
+# 否则控制权不返回，`.cmd` 里后面的 `echo %ERRORLEVEL%` 永远不执行、状态文件永不出现。
+
+_JOB_DEFAULT_TAIL_BYTES = 2000
+_JOB_POLL_INTERVAL = 0.5
+_JOB_INDEX_DIRNAME = "vivado_mcp_tcl_jobs"
+_JOB_ID_RE = re.compile(r"^tcljob-\d{8}-\d{6}-[0-9a-fA-F]{6}$")
+# 计划任务名（脱离式兜底用；job_id 唯一 ⇒ 任务名唯一，可确定性推导/幂等清理）
+_SCHTASKS_TASK_PREFIX = "dshvivado-tcljob-"
+
+# Windows 进程创建标志（stdlib subprocess 提供）
+_DETACHED_PROCESS = 0x00000008
+_CREATE_NEW_PROCESS_GROUP = 0x00000200
+# 父进程在 Job Object 里时，只有它能让我们逃出 job（且要求 job 允许 breakaway）
+_CREATE_BREAKAWAY_FROM_JOB = 0x01000000
+
+# 进程内缓存：{job_id: record}。server 重启后由 _resolve_job 从 sidecar 读回。
+_JOBS: dict[str, dict] = {}
+
+
+class _JobError(RuntimeError):
+    """作业启动前的校验失败；消息直接作为 ``[ERROR]`` 文本返回给调用方。"""
+
+
+def _now_iso() -> str:
+    """本地时间 ISO 字符串（秒精度，人眼可读，够排序）。"""
+    return datetime.datetime.now().isoformat(timespec="seconds")
+
+
+def _job_index_dir() -> str:
+    """跨进程/跨重启的 job_id 索引目录（TEMP 下，随 TEMP 环境变量走）。"""
+    d = os.path.join(tempfile.gettempdir(), _JOB_INDEX_DIRNAME)
+    os.makedirs(d, exist_ok=True)
+    return d
+
+
+def _read_json_file(path: str) -> dict | None:
+    """读 JSON 对象；文件不存在 / 半写 / 非对象一律返回 None（不抛）。"""
+    if not path:
+        return None
+    try:
+        with open(path, "r", encoding="utf-8") as f:
+            data = json.load(f)
+    except (OSError, ValueError):
+        return None
+    return data if isinstance(data, dict) else None
+
+
+def _write_job(record: dict) -> None:
+    """把作业记录写盘：canonical 状态文件（日志同目录）+ 索引副本，写失败不抛。"""
+    _JOBS[record["job_id"]] = record
+    index_path = os.path.join(_job_index_dir(), f"{record['job_id']}.job.json")
+    for path in (record.get("status_path") or "", index_path):
+        try:
+            parent = os.path.dirname(os.path.abspath(path))
+            if parent:
+                os.makedirs(parent, exist_ok=True)
+            tmp = path + ".tmp"
+            with open(tmp, "w", encoding="utf-8") as f:
+                json.dump(record, f, ensure_ascii=False, indent=1)
+            os.replace(tmp, path)
+        except OSError:
+            # 状态文件写不了不影响作业本身（进程已经在跑），只是查不了
+            continue
+
+
+def _resolve_job(job_id: str) -> dict | None:
+    """job_id → 作业记录：先内存缓存，再按索引文件 + canonical 状态文件读回。"""
+    jid = (job_id or "").strip()
+    if not _JOB_ID_RE.match(jid):
+        return None
+    record = _JOBS.get(jid) or _read_json_file(
+        os.path.join(_job_index_dir(), f"{jid}.job.json")
+    )
+    if record is None:
+        return None
+    canonical = record.get("status_path") or ""
+    fresh = _read_json_file(canonical) if canonical else None
+    record = fresh or record
+    _JOBS[jid] = record
+    return record
+
+
+def _read_tail(path: str, n_bytes: int) -> str:
+    """读文件末尾 n_bytes 字节（UTF-8 边界安全）；路径空 / 读不到返回空串。"""
+    if not path:
+        return ""
+    n = max(1, int(n_bytes or 0))
+    try:
+        with open(path, "rb") as f:
+            f.seek(0, os.SEEK_END)
+            size = f.tell()
+            f.seek(max(0, size - n))
+            raw = f.read()
+    except OSError:
+        return ""
+    return raw[_utf8_boundary(raw, 0):].decode("utf-8", errors="replace")
+
