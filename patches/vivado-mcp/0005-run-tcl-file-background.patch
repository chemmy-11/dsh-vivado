+def _utf8_boundary(raw: bytes, start: int) -> int:
+    """把 start 前移到 UTF-8 字符边界（跳过 ``10xxxxxx`` 续字节）。
+
+    末尾 N 字节裁剪的切点几乎必然落在某个字符中间；前移到下一个字符起点后，
+    ``raw[start:]`` 保证是合法 UTF-8，不会切出半个汉字（坑 #78）。
+    """
+    while start < len(raw) and (raw[start] & 0xC0) == 0x80:
+        start += 1
+    return start
+
+
