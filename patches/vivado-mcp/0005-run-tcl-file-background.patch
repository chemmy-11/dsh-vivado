+    包装器 .cmd 的内容必须是纯 ASCII，且不能含批处理元字符——中文路径会被
+    cmd.exe 按 OEM 代码页吃掉（中文工程路径正是 start_session 必失败的同族坑）。
+    """
+    if not path:
+        return "空路径"
+    try:
+        path.encode("ascii")
+    except UnicodeEncodeError:
+        return "含非 ASCII 字符（批处理/控制台代码页会破坏它）"
+    for ch in '!%^&|<>"':
+        if ch in path:
+            return f"含批处理元字符 {ch!r}"
+    return ""
