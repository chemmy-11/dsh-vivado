+        head = f"[OK] Tcl 脚本已跑完（退出码 0），总耗时 {elapsed:.1f} s"
+    elif status == "failed":
+        head = (
+            f"[ERROR] Tcl 脚本已退出但返回码非 0（退出码 {code}），"
+            f"总耗时 {elapsed:.1f} s —— 请看下方日志尾部"
+        )
