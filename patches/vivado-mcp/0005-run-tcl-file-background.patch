+    while True:
+        status, code = _job_state(record)
+        if status != "running":
+            _finalize_job(record, status, code)
+            return False
+        if time.monotonic() >= deadline:
+            return True
+        await asyncio.sleep(_JOB_POLL_INTERVAL)
