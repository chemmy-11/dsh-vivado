+def _read_rc(rc_path: str) -> int | None:
+    """读包装器写下的一行 ``!ERRORLEVEL!``；没落地 / 内容不像整数返回 None。"""
+    if not rc_path:
+        return None
+    try:
+        with open(rc_path, "r", encoding="utf-8", errors="replace") as f:
+            raw = f.read().strip()
+    except OSError:
+        return None
+    m = re.search(r"-?\d+", raw)
+    return int(m.group(0)) if m else None
+
