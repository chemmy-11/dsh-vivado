+def _process_state(pid: int) -> tuple[bool, int | None]:
+    """返回 ``(是否存活, 已退出时的退出码)``；只用 stdlib（ctypes / os.kill）。
+
+    Windows 走 ``OpenProcess + GetExitCodeProcess``：不引入 psutil 之类的依赖，
+    也不需要 tasklist 的文本输出（locale 一变就解析错）。
+    """
+    try:
+        pid = int(pid)
+    except (TypeError, ValueError):
+        return False, None
+    if pid <= 0:
+        return False, None
+
+    if sys.platform == "win32":
+        import ctypes
+
+        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+        kernel32.OpenProcess.argtypes = [ctypes.c_uint32, ctypes.c_int, ctypes.c_uint32]
+        kernel32.OpenProcess.restype = ctypes.c_void_p
+        kernel32.GetExitCodeProcess.argtypes = [
+            ctypes.c_void_p,
+            ctypes.POINTER(ctypes.c_uint32),
+        ]
+        kernel32.GetExitCodeProcess.restype = ctypes.c_int
+        kernel32.CloseHandle.argtypes = [ctypes.c_void_p]
+
+        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
+        STILL_ACTIVE = 259
+        ERROR_ACCESS_DENIED = 5
+        handle = kernel32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid)
+        if not handle:
+            # 拿不到句柄：ACL 拒绝通常意味着「进程还在，只是不让我们问」；
+            # 进程真不存在时 GetLastError 是 87（Invalid Parameter）。
+            return ctypes.get_last_error() == ERROR_ACCESS_DENIED, None
+        try:
+            code = ctypes.c_uint32(0)
+            if not kernel32.GetExitCodeProcess(handle, ctypes.byref(code)):
+                return False, None
+            if code.value == STILL_ACTIVE:
+                return True, None
+            return False, int(code.value)
+        finally:
+            kernel32.CloseHandle(handle)
+
+    try:
+        os.kill(pid, 0)
+        return True, None
+    except OSError:
+        return False, None
+
