+    kernel32.IsProcessInJob.restype = ctypes.c_int
+    result = ctypes.c_int(0)
+    ok = kernel32.IsProcessInJob(kernel32.GetCurrentProcess(), None, ctypes.byref(result))
+    return bool(ok) and bool(result.value)
+
+
+def _job_kills_on_close() -> bool:
+    """本进程所在的 Job Object 是否设了 ``JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE``。
+
+    只有这种 job 才会在宿主关闭时**连带杀掉**我们 Popen 出去的孙子进程——这才是
+    需要走 Task Scheduler 逃生的判据（单纯「在某个 job 里」不影响脱离）。
+
+    MCP 官方 Python SDK 的 ``stdio_client`` 就给 server 进程建这种 job
+    （``mcp/os/win32/utilities.py``：``LimitFlags |= JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE``），
+    实测真 Vivado 的 2 分钟 batch 在 server 退出后 1.8 s 被杀。
+    """
+    if sys.platform != "win32":
+        return False
+    import ctypes
+
+    class _BasicLimit(ctypes.Structure):
+        _fields_ = [
+            ("PerProcessUserTimeLimit", ctypes.c_int64),
+            ("PerJobUserTimeLimit", ctypes.c_int64),
+            ("LimitFlags", ctypes.c_uint32),
+            ("MinimumWorkingSetSize", ctypes.c_size_t),
+            ("MaximumWorkingSetSize", ctypes.c_size_t),
+            ("ActiveProcessLimit", ctypes.c_uint32),
+            ("Affinity", ctypes.c_size_t),
+            ("PriorityClass", ctypes.c_uint32),
+            ("SchedulingClass", ctypes.c_uint32),
+        ]
+
+    class _IoCounters(ctypes.Structure):
+        _fields_ = [
+            ("ReadOperationCount", ctypes.c_uint64),
+            ("WriteOperationCount", ctypes.c_uint64),
+            ("OtherOperationCount", ctypes.c_uint64),
+            ("ReadTransferCount", ctypes.c_uint64),
+            ("WriteTransferCount", ctypes.c_uint64),
+            ("OtherTransferCount", ctypes.c_uint64),
+        ]
+
+    class _ExtendedLimit(ctypes.Structure):
+        _fields_ = [
+            ("BasicLimitInformation", _BasicLimit),
+            ("IoInfo", _IoCounters),
+            ("ProcessMemoryLimit", ctypes.c_size_t),
+            ("JobMemoryLimit", ctypes.c_size_t),
+            ("PeakProcessMemoryUsed", ctypes.c_size_t),
+            ("PeakJobMemoryUsed", ctypes.c_size_t),
+        ]
+
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    kernel32.QueryInformationJobObject.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_int,
+        ctypes.c_void_p,
+        ctypes.c_uint32,
+        ctypes.POINTER(ctypes.c_uint32),
+    ]
+    kernel32.QueryInformationJobObject.restype = ctypes.c_int
+    info = _ExtendedLimit()
+    returned = ctypes.c_uint32(0)
+    # JobObjectExtendedLimitInformation == 9；hJob=NULL ⇒ 查本进程所在 job（Windows 8+
+    # 嵌套 job 时返回最内层那个）
+    ok = kernel32.QueryInformationJobObject(
+        None, 9, ctypes.byref(info), ctypes.sizeof(info), ctypes.byref(returned)
+    )
+    if not ok:
+        return False  # 不在 job 里／查询失败 ⇒ 不会被连带回收
+    return bool(info.BasicLimitInformation.LimitFlags & 0x00002000)
+
+
+def _run_schtasks(args: list[str], timeout: float = 30.0) -> tuple[int, str]:
+    """跑 schtasks 并返回 ``(returncode, 合并输出)``；只判 returncode，不解析文案。
+
+    踩过的坑：``/st`` 早于当前时间时 schtasks 会在 **stderr** 打一行 WARNING，在
+    PowerShell 的 ``$ErrorActionPreference='Stop'`` 下会变成 terminating error 把
+    启动流程打断。这里直接 subprocess 采集，不存在该问题。
+    """
+    try:
+        completed = subprocess.run(
+            ["schtasks", *args],
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+            timeout=timeout,
+        )
+    except (OSError, subprocess.TimeoutExpired) as e:
+        return -1, f"schtasks {args[0] if args else ''} 调用失败: {e}"
+    text = (completed.stdout or b"").decode("mbcs", "replace")
+    return completed.returncode, text
+
+
+def _expired_task_dates() -> list[str]:
+    """过期一次性任务的 ``/sd`` 候选：优先 MM/DD/YYYY，其次 YYYY/MM/DD。
+
+    schtasks 的 ``/sd`` 跟随系统区域格式，猜错会 create 失败（returncode≠0），
+    所以两个都试一遍；一年前的日期让 ``Next Run Time`` 变成 N/A ⇒ 永远不会按
+    计划自触发，只能靠 ``/run`` 手动触发。
+    """
+    import datetime as _dt
+
+    d = _dt.date.today() - _dt.timedelta(days=365)
+    return [d.strftime("%m/%d/%Y"), d.strftime("%Y/%m/%d")]
+
+
+def _delete_task(task_name: str) -> None:
+    """幂等删任务（不存在也算成功）；清理残留用，绝不抛。"""
+    if not task_name:
+        return
+    _run_schtasks(["/delete", "/tn", task_name, "/f"], timeout=20.0)
+
+
+def _write_findpid_script(out_dir: str, job_id: str) -> str:
+    """写一个 ASCII 的 .ps1：按命令行里的 job_id 反查包装器 cmd.exe 的 PID。
+
+    为什么需要：Task Scheduler 的 ``/run`` 只回 "已尝试运行"，不给 PID；而构建进程
+    是 svchost(计划任务服务) 的子进程，我们拿不到句柄。``Get-CimInstance`` 查询在
+    本机实测正常（只有 ``Win32_Process.Create`` 这个 provider 挂了），所以按
+    CommandLine 里唯一的 job_id 反查是最稳的办法。
+    """
+    path = os.path.join(out_dir, f"{job_id}.findpid.ps1")
+    script = "\r\n".join(
+        [
+            "param([string]$JobId, [string]$OutFile)",
+            "$p = Get-CimInstance Win32_Process -Filter \"Name='cmd.exe'\" |",
+            "     Where-Object { $_.CommandLine -like ('*' + $JobId + '*') } |",
+            "     Select-Object -First 1",
+            'if ($p) { "PID=$($p.ProcessId)" | Out-File -Encoding ascii -NoNewline $OutFile }',
+            'else { "PID=0" | Out-File -Encoding ascii -NoNewline $OutFile }',
+            "",
+        ]
+    )
+    try:
+        with open(path, "w", encoding="ascii", newline="") as f:
+            f.write(script)
+    except OSError:
+        return ""
+    return path
+
+
+def _find_job_pid(job_id: str, out_dir: str) -> int:
+    """按 job_id 反查包装器 PID；找不到返回 0（最多等约 6 秒）。"""
+    script = _write_findpid_script(out_dir, job_id)
+    if not script:
+        return 0
+    result_path = os.path.join(out_dir, f"{job_id}.pid.txt")
+    args = [
+        "powershell.exe",
+        "-NoProfile",
+        "-NonInteractive",
+        "-ExecutionPolicy",
+        "Bypass",
+        "-File",
+        script,
+        "-JobId",
+        job_id,
+        "-OutFile",
+        result_path,
+    ]
+    for attempt in range(12):
+        try:
+            subprocess.run(
+                args,
+                stdin=subprocess.DEVNULL,
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+                timeout=30,
+            )
+        except (OSError, subprocess.TimeoutExpired):
+            return 0
+        match = re.search(r"PID=(\d+)", _read_text(result_path))
+        if match and int(match.group(1)) > 0:
+            return int(match.group(1))
+        time.sleep(0.5 if attempt else 0.2)
+    return 0
+
+
+def _write_wmi_script(out_dir: str, job_id: str, mode: str) -> str:
+    """写 ASCII 的 WMI 启动器（``mode="com"`` 老式 COM / ``mode="cim"`` Invoke-CimMethod）。
+
+    为什么必须落成 ``.ps1`` + ``powershell -File``：``[wmiclass]'Win32_Process'.Create()``
+    走 DCOM/vtable，由 **WmiPrvSE.exe** 创建进程 ⇒ 天然不在调用方的 Job Object 里；
+    而 ``-Command`` 内联串要过 cmd/PowerShell 两层引号，实测会把 CommandLine 参数切坏
+    （Create 返回 RV=8，30 s 后才失败）。COM 与 CIM 是两条不同的 provider 路径：
+    本机 CIM(``Invoke-CimMethod``) 恒 RV=8，COM 可用。
+    """
+    path = os.path.join(out_dir, f"{job_id}.wmi_{mode}.ps1")
+    if mode == "com":
+        body = [
+            "param([string]$CommandLine, [string]$CurrentDir)",
+            "$ErrorActionPreference = 'Stop'",
+            "try {",
+            "  $si = ([wmiclass]'Win32_ProcessStartup').CreateInstance()",
+            "  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP: no console window, own process group",
+            "  $si.CreateFlags = 0x208",
+            "  $r = ([wmiclass]'Win32_Process').Create($CommandLine, $CurrentDir, $si)",
+            "  if ($r.ReturnValue -ne 0) {",
+            "    $r = ([wmiclass]'Win32_Process').Create($CommandLine, $CurrentDir, $null)",
+            "  }",
+            '  "COM_RV=$($r.ReturnValue) COM_PID=$($r.ProcessId)"',
+            "} catch {",
+            '  "COM_RV=ERR COM_PID=0 MSG=$($_.Exception.Message)"',
+            "}",
+        ]
+    else:
+        body = [
+            "param([string]$CommandLine, [string]$CurrentDir)",
+            "$ErrorActionPreference = 'Stop'",
+            "try {",
+            "  $r = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{CommandLine=$CommandLine; CurrentDirectory=$CurrentDir}",
+            '  "CIM_RV=$($r.ReturnValue) CIM_PID=$($r.ProcessId)"',
+            "} catch {",
+            '  "CIM_RV=ERR CIM_PID=0 MSG=$($_.Exception.Message)"',
+            "}",
+        ]
+    try:
+        with open(path, "w", encoding="ascii", newline="") as f:
+            f.write("\r\n".join(body) + "\r\n")
+    except OSError as e:
+        raise _JobError(f"无法写 WMI 启动器 {path}: {e}") from None
+    return path
+
+
+def _spawn_via_wmi(
+    cmd_path: str, workdir: str, out_dir: str, job_id: str, mode: str
+) -> int:
+    """用 WMI（com 优先 / cim 兜底）启动包装器，返回包装器 PID。
+
+    进程由 WmiPrvSE 创建 ⇒ Job Object 成员资格继承自 WmiPrvSE（不是我们），宿主的
+    ``TerminateJobObject`` / KILL_ON_JOB_CLOSE 打不到它（实测：helper 在 kill-on-close
+    job 里用 COM 起的目标进程，关 job 句柄后 +5/+15/+30 s 仍存活）。
+    """
+    script = _write_wmi_script(out_dir, job_id, mode)
+    cmd_line = f'cmd.exe /c "{os.path.normpath(cmd_path)}"'
+    args = [
+        "powershell.exe",
+        "-NoProfile",
+        "-NonInteractive",
+        "-ExecutionPolicy",
+        "Bypass",
+        "-File",
+        script,
+        "-CommandLine",
+        cmd_line,
+        "-CurrentDir",
+        os.path.normpath(workdir),
+    ]
+    try:
+        completed = subprocess.run(
+            args,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=120,
+        )
+    except (OSError, subprocess.TimeoutExpired) as e:
+        raise _JobError(f"powershell 调用失败（wmi-{mode}）: {e}") from None
+
+    tag = "COM" if mode == "com" else "CIM"
+    text = (completed.stdout or b"").decode("utf-8", "replace")
+    rv_match = re.search(rf"{tag}_RV=(-?\d+)", text)
+    pid_match = re.search(rf"{tag}_PID=(\d+)", text)
+    if not rv_match:
+        stderr_text = (completed.stderr or b"").decode("utf-8", "replace").strip()
+        raise _JobError(
+            f"wmi-{mode} 没有返回 {tag}_RV（stdout={text.strip()[:150] or '空'}；"
+            f"stderr={stderr_text[:150] or '空'}）"
+        )
+    rv = int(rv_match.group(1))
+    pid = int(pid_match.group(1)) if pid_match else 0
+    if rv != 0 or pid <= 0:
+        msg_match = re.search(r"MSG=(.*)", text)
+        detail = msg_match.group(1).strip()[:150] if msg_match else ""
+        raise _JobError(f"wmi-{mode} 的 Win32_Process.Create 返回 RV={rv} PID={pid} {detail}")
+    return pid
+
+
+def _spawn_via_schtasks(task_name: str, cmd_path: str, reason: str) -> None:
+    """用「已过期的一次性计划任务 + /run」启动包装器（最后兜底，长构建勿用）。
+
+    计划任务实例由 Task Scheduler 服务（svchost）创建 ⇒ 也不在调用方 job 里。但
+    **schtasks 建的默认任务带 IdleSettings{Duration=PT10M, StopOnIdleEnd=true}**：
+    机器空闲 10 分钟就会停掉任务实例 —— 实测 34 分钟的 impl 段跑到 9m20s 被静默杀掉
+    （无 rc、日志停在 place_design Phase 3.2）。所以它只作最后兜底，长构建优先 WMI。
+    """
+    last_text = ""
+    created = False
+    for date_str in _expired_task_dates():
+        rc, text = _run_schtasks(
+            [
+                "/create",
+                "/tn",
+                task_name,
+                "/tr",
+                f'"{os.path.normpath(cmd_path)}"',
+                "/sc",
+                "once",
+                "/st",
+                "00:00",
+                "/sd",
+                date_str,
+                "/f",
+            ]
+        )
+        last_text = text
+        if rc == 0:
+            created = True
+            break
+    if not created:
+        raise _JobError(
+            f"计划任务创建失败（{reason}）：{last_text.strip()[:300] or '无输出'}"
+        )
+
+    rc, text = _run_schtasks(["/run", "/tn", task_name])
+    if rc != 0:
+        _delete_task(task_name)
+        raise _JobError(f"计划任务 /run 失败（{reason}）：{text.strip()[:300] or '无输出'}")
+
+
+def _task_exists(task_name: str) -> bool:
+    """任务定义是否还在（``/query`` 的 returncode 判据，无视本地化文案）。"""
+    if not task_name:
+        return False
+    rc, _text = _run_schtasks(["/query", "/tn", task_name], timeout=20.0)
+    return rc == 0
+
+
+def _launch_job(script_path: str, log_file: str = "") -> dict:
+    """校验 + 生成包装器 + 脱离进程树启动，返回作业记录（失败抛 _JobError）。
+
+    目录布局（log 同目录，ASCII）::
+
+        <out_dir>/<job_id>.cmd           包装器（ASCII / CRLF）
+        <out_dir>/<job_id>.rc            包装器写的 !ERRORLEVEL!（完成判据）
+        <out_dir>/<job_id>.job.json      状态文件（canonical sidecar）
+        <out_dir>/<job_id>.console.txt   Vivado 的 stdout+stderr 重定向
+        <stem>.vivado.log / .jou         Vivado 自己的 -log / -journal
+    """
+    script = os.path.abspath((script_path or "").strip())
+    if not os.path.isfile(script):
+        raise _JobError(
+            f"script_path 不存在或不是文件: {script_path!r}。"
+            "请传绝对路径（例如 D:/FPGA/scripts/run_impl.tcl），不要传 Tcl 命令文本。"
+        )
+
+    try:
+        vivado = find_vivado()
+    except FileNotFoundError as e:
+        raise _JobError(
+            f"找不到 Vivado 可执行文件：{e} 可设置 VIVADO_PATH 环境变量指向 vivado.bat。"
+        ) from None
+
+    workdir = os.path.abspath(os.getcwd())
+
+    # job_id 先定下来：日志/控制台文件名都带上它，同一脚本并发跑两次也不会互相覆盖
+    job_id = f"tcljob-{time.strftime('%Y%m%d-%H%M%S')}-{os.urandom(3).hex()}"
+
+    stem = os.path.splitext(os.path.basename(script))[0]
+    if (log_file or "").strip():
+        log_path = os.path.abspath(log_file.strip())
+        out_dir = os.path.dirname(log_path) or workdir
+        journal_path = (
+            log_path[:-4] + ".jou" if log_path.lower().endswith(".log") else log_path + ".jou"
+        )
+    else:
+        out_dir = os.path.dirname(script) or workdir
+        log_path = os.path.join(out_dir, f"{stem}.{job_id}.log")
+        journal_path = os.path.join(out_dir, f"{stem}.{job_id}.jou")
+    console_path = os.path.join(out_dir, f"{job_id}.console.txt")
+
+    try:
+        os.makedirs(out_dir, exist_ok=True)
+    except OSError as e:
+        raise _JobError(f"无法创建日志目录 {out_dir}: {e}") from None
+
+    status_path = os.path.join(out_dir, f"{job_id}.job.json")
+    rc_path = os.path.join(out_dir, f"{job_id}.rc")
+    cmd_path = os.path.join(out_dir, f"{job_id}.cmd")
+    # 计划任务名确定性可推导：job_id 唯一 ⇒ 任务名唯一；用于脱离式兜底与幂等清理
+    task_name = f"{_SCHTASKS_TASK_PREFIX}{job_id}"
+
+    problems = []
+    for label, path in (
+        ("当前工作目录(cwd)", workdir),
+        ("脚本", script),
+        ("日志目录", out_dir),
+        ("Vivado", vivado),
+    ):
+        why = _batch_path_problem(path)
+        if why:
+            problems.append(f"{label} {path} → {why}")
+    if problems:
+        raise _JobError(
+            "路径不能用于 batch 启动（要求纯 ASCII 且不含批处理元字符）："
+            + "；".join(problems)
+            + "。请把 Tcl 脚本与日志目录放到纯 ASCII 路径下。"
+        )
+
+    # 关键：调用另一个 .bat 必须 call，否则控制权不返回、rc 永不落地（实测踩过）
+    cmd_text = "\r\n".join(
+        [
+            "@echo off",
+            "setlocal EnableDelayedExpansion",
+            f'cd /d "{os.path.normpath(workdir)}"',
+            f'call "{os.path.normpath(vivado)}" -mode batch'
+            f' -source "{os.path.normpath(script)}" -notrace'
+            f' -log "{os.path.normpath(log_path)}"'
+            f' -journal "{os.path.normpath(journal_path)}"'
+            f' > "{os.path.normpath(console_path)}" 2>&1',
+            f'echo !ERRORLEVEL! > "{os.path.normpath(rc_path)}"',
+            # 必须最后一行：删除自己的计划任务会终止本任务实例，而 BUILD_EXIT 已经落盘。
+            # 任务不存在时 schtasks 返回非 0，直接丢弃输出即可（幂等）。
+            f'schtasks /delete /tn "{task_name}" /f >nul 2>&1',
+            "endlocal",
+            "",
+        ]
+    )
+    try:
+        with open(cmd_path, "w", encoding="ascii", newline="") as f:
+            f.write(cmd_text)
+    except OSError as e:
+        raise _JobError(f"无法写包装脚本 {cmd_path}: {e}") from None
+
+    popen_kwargs: dict = {
+        "cwd": workdir,
+        # 三个流全部不接管道：MCP server 退出 / ^C 都波及不到构建
+        "stdin": subprocess.DEVNULL,
+        "stdout": subprocess.DEVNULL,
+        "stderr": subprocess.DEVNULL,
+        "close_fds": True,
+    }
+    if sys.platform == "win32":
+        # DETACHED_PROCESS：不继承 server 的控制台/进程组；
+        # CREATE_NEW_PROCESS_GROUP：Ctrl 事件不投递到构建进程组；
+        # CREATE_BREAKAWAY_FROM_JOB：父进程在 Job Object 里时尝试脱离
+        #   （job 允许 breakaway 才行；不允许时 CreateProcess 直接 Errno 5）。
+        popen_kwargs["creationflags"] = (
+            _DETACHED_PROCESS | _CREATE_NEW_PROCESS_GROUP | _CREATE_BREAKAWAY_FROM_JOB
+        )
+    pid = 0
+    launcher = ""
+    attempts: list[str] = []  # 每次尝试失败的原因，全挂时一起报给调用方
+
+    # ① Popen + DETACHED_PROCESS（不加 job / job 不连带杀人时最省事）
+    use_popen = not (sys.platform == "win32" and _job_kills_on_close())
+    if use_popen:
+        try:
+            proc = subprocess.Popen(["cmd.exe", "/c", cmd_path], **popen_kwargs)
+            pid, launcher = proc.pid, "popen"
+        except OSError as e:
+            if sys.platform != "win32":
+                raise _JobError(f"启动 cmd 包装器失败: {e}") from None
+            attempts.append(f"popen 被拒: {e}")
+    else:
+        # 所在的 job 设了 KILL_ON_JOB_CLOSE（MCP 官方 Python SDK 客户端就是这样）：
+        # 即使 Popen 带 CREATE_BREAKAWAY_FROM_JOB 成功返回，子进程仍留在 job 链里——
+        # 实测 server 退出后真 Vivado 的 2 分钟 batch 在 1.8 s 被杀。直接跳过。
+        attempts.append("popen 跳过: 所在 job 设了 KILL_ON_JOB_CLOSE，子进程会被连带回收")
+
+    # ② WMI-COM（[wmiclass]'Win32_Process'.Create）：进程由 WmiPrvSE 创建，天然在 job 外
+    if not launcher and sys.platform == "win32":
+        try:
+            pid = _spawn_via_wmi(cmd_path, workdir, out_dir, job_id, "com")
+            launcher = "wmi-com"
+        except _JobError as e:
+            attempts.append(str(e))
+
+    # ③ WMI-CIM（Invoke-CimMethod）：本机恒 RV=8，留作别的机器上的备选
