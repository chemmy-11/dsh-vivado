+def checkpoint_facts(path_text: str) -> dict:
+    """读取 ``.dcp`` 的文件事实（存在/绝对路径/字节数/修改时间），不打开检查点。
+
+    只做 stat,不执行 ``open_checkpoint``(后者要 8-34 分钟并占用全局唯一的 Vivado
+    会话,不能塞进一个"最后一瞥"级别的工具)。返回值是纯数据，交给
+    ``format_checkpoint_facts`` 排版；路径无法解析时 exists=False 而不是抛异常
+    —— 用户输错路径要看到"不存在"的明确说明,而不是一个工具级 [ERROR]。
+    """
+    raw = (path_text or "").strip()
+    expanded = Path(raw).expanduser()
+    try:
+        resolved = str(expanded.resolve())
+    except OSError:  # 非法路径字符等:保留用户输入,不中断判定
+        resolved = str(expanded)
+    facts = {
+        "input": raw, "resolved": resolved, "exists": False,
+        "size_bytes": None, "mtime": None,
+    }
+    try:
+        if expanded.is_file():
+            stat = expanded.stat()
+            facts["size_bytes"] = stat.st_size
+            facts["mtime"] = datetime.fromtimestamp(
+                stat.st_mtime
+            ).astimezone().isoformat(timespec="seconds")
+            facts["exists"] = True
+    except OSError:
+        pass
+    return facts
+
+
+def format_checkpoint_facts(facts: dict) -> list[str]:
+    """把 ``checkpoint_facts`` 的返回值排成一段，含"只能证明已写出"的边界声明。"""
+    out = ["", "检查点(.dcp)事实:"]
+    out.append(f"  输入: {facts.get('input') or '(空)'}")
+    out.append(f"  绝对路径: {facts.get('resolved') or '(无法解析)'}")
+    if facts.get("exists"):
+        size = int(facts["size_bytes"])
+        out.append("  存在: 是")
+        out.append(f"  字节数: {size} ({size / (1024 * 1024):.1f} MiB)")
+        out.append(f"  修改时间: {facts.get('mtime')}")
+    else:
+        out.append("  存在: 否（文件不存在或不是普通文件）")
+    out.append("  边界: .dcp 只能证明检查点已写出，不能离线证明时序已收敛或可烧写。")
+    out.append(
+        "  说明: 本工具不会对 .dcp 执行 open_checkpoint（一次 8-34 分钟开销）；"
+        "要看实现后时序请用 get_timing_report(report_file=...)。"
+    )
+    return out
+
