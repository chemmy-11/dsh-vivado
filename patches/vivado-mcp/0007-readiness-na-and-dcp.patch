 """
 
 
+# 输出:
+#   VMCP_PRE_BIT:status=<STATUS>,critical_warnings=<N>   —— run 存在且状态可读(原语义)
+#   VMCP_PRE_BIT:status=RUN_NOT_FOUND,critical_warnings=-1 —— run 不存在/无工程
+#   VMCP_PRE_BIT_TOP:<top> / VMCP_PRE_BIT_CW:<样本> / VMCP_PRE_BIT_DONE
+#
+# 为什么要有 RUN_NOT_FOUND 分支:原来直接 `get_runs {impl_run}` 再
+# `get_property STATUS` 一个空列表,run 不存在时会抛
+# `ERROR: [Common 17-161] Invalid option value '' specified for 'object'`,
+# 整条脚本 rc=1,Python 侧只能把"run 不存在"报成 [ERROR] [DEGRADED]。但
+# checkpoint 式自定义实现(synth→write_checkpoint→open_checkpoint→place/route)
+# 本来就没有 impl_1 run —— 那时 run 状态类判据根本不适用,报错是误报。
+# 这里用 catch 兜住 get_runs(无工程时 get_runs 也会抛),空列表 → 显式发
+# RUN_NOT_FOUND 标记,由 analysis/timing_evidence.py 翻成 N/A(不适用)判定。
 CHECK_PRE_BITSTREAM = """\
-set __impl [get_runs {impl_run}]
+if {{[catch {{get_runs -quiet {impl_run}}} __impl]}} {{ set __impl [list] }}
+if {{[llength $__impl] == 0}} {{
+    puts "VMCP_PRE_BIT:status=RUN_NOT_FOUND,critical_warnings=-1"
+    puts "VMCP_PRE_BIT_DONE"
+}} else {{
 set __status [get_property STATUS $__impl]
 set __dir [get_property DIRECTORY $__impl]
 set __log "$__dir/runme.log"
@@ -803,4 +820,30 @@
     puts "VMCP_PRE_BIT_CW:$__s"
 }}
 puts "VMCP_PRE_BIT_DONE"
-"""
+}}
+"""
+
+
+def guard_appended_script(script: str, marker: str = "VMCP_STAGE_ERROR") -> str:
+    """把"附加查询脚本"包进 catch,再拼到主脚本后面一起执行。
+
+    用途:`report_tools.check_bitstream_readiness` 一次 execute 里拼了
+    ``CHECK_PRE_BITSTREAM + QUERY_DESIGN_STAGE``。没有打开的工程时
+    QUERY_DESIGN_STAGE 里的 ``get_runs`` 会抛错(``No open project``),于是整条
+    拼接脚本 rc=1,主判据(已打印的 ``VMCP_PRE_BIT`` 行)反而被 Python 侧的
+    ``is_error`` 分支盖成 ``[ERROR] [DEGRADED]``。
+
+    包进 catch 后:主判据照旧输出;附加查询失败只在输出里留一行
+    ``<marker>:<原因>``,rc 仍为 0。QUERY_DESIGN_STAGE 自身文本不变,
+    ``get_timing_report`` 那边仍原样单独执行(不受本包装影响)。
+
+    注意:这里靠花括号引用把 script 当字面脚本体,Tcl 的花括号计数要求
+    script 内花括号平衡 —— 本模块里的脚本常量都满足(它们本身就是合法 Tcl)。
+    """
+    return (
+        "if {[catch {\n"
+        f"{script}"
+        "} __vmcp_appended_err]} {\n"
+        f'    puts "{marker}:$__vmcp_appended_err"\n'
+        "}\n"
+    )

