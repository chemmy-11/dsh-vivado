--- /dev/null
+++ b/vivado_mcp/analysis/path_hints.py
@@ -0,0 +1,131 @@
+"""路径猜错时的候选发现（只影响"文件不存在"的报错文本，不改变成功路径的行为）。
+
+2026-11-10 实测：组员把工程文件拼成 ``<repo>/prj/project_13/prj13.xpr``，而仓库里实际在
+``<repo>/prj/project_13/vivado/prj13.xpr``。工具只回一句 "XPR 文件不存在: ..."，模型会继续
+换路径猜，而不是先去定位真实位置。
+
+本模块只做一件事：在**精确路径不存在**时，从最近的已存在父目录向下按扩展名找候选
+（深度 <= 6、目录数 <= 2000、最多 5 个、跳过 .git/node_modules/.Xil/xsim.dir 等），
+把候选拼进异常文本；找不到时提示"先定位工程根/产物目录，不要继续猜路径"。
+找到文件时本模块不参与任何逻辑，因此成功路径的输出逐字节不变。
+"""
+
+from __future__ import annotations
+
+import fnmatch
+import os
+from pathlib import Path
+
+# 搜索上限：防止在巨大的仓库/盘符根上做无边界的全盘扫描
+_MAX_DEPTH = 6
+_MAX_DIRS = 2000
+_MAX_HITS = 5
+
+_SKIP_DIRS = {
+    ".git", ".svn", ".hg", "node_modules", "__pycache__", ".venv", "venv",
+    ".Xil", "xsim.dir", "site-packages", ".idea", ".vscode",
+}
+
+
+def _norm(path: str) -> str:
+    raw = (path or "").strip().strip('"').strip("'")
+    if not raw:
+        return ""
+    return os.path.normpath(os.path.expanduser(raw))
+
+
+def pattern_for(path: str, pattern: str | None = None) -> str:
+    """候选匹配模式：显式给就用显式的，否则按目标文件的扩展名推导。"""
+    if pattern:
+        return pattern
+    suffix = Path(path).suffix
+    return "*" + suffix if suffix else "*"
+
+
+def _nearest_existing_dir(target: Path) -> Path | None:
+    cur = target if target.is_dir() else target.parent
+    while cur and not cur.exists():
+        parent = cur.parent
+        if parent == cur:
+            return None
+        cur = parent
+    if not cur or not cur.is_dir():
+        return None
+    # 盘符根 / 文件系统根不做递归搜索（会变成全盘扫描，且噪声远大于收益）
+    if len(cur.parts) <= 1:
+        return None
+    return cur
+
+
+def _collect(root: Path, pat: str) -> list[str]:
+    hits: list[str] = []
+    seen_dirs = 0
+    root_depth = len(root.parts)
+    for dirpath, dirnames, filenames in os.walk(root, onerror=lambda _e: None):
+        seen_dirs += 1
+        if seen_dirs > _MAX_DIRS:
+            break
+        depth = len(Path(dirpath).parts) - root_depth
+        if depth >= _MAX_DEPTH:
+            dirnames[:] = []
+        else:
+            dirnames[:] = [d for d in dirnames if d not in _SKIP_DIRS]
+        for name in filenames:
+            if fnmatch.fnmatch(name.lower(), pat.lower()):
+                hits.append(os.path.join(dirpath, name))
+                if len(hits) >= _MAX_HITS * 20:
+                    return hits
+    return hits
+
+
+def suggest_paths(path: str, pattern: str | None = None, max_hits: int = _MAX_HITS) -> list[str]:
+    """路径不存在时返回附近候选（最多 ``max_hits`` 个）；任何异常都退化成空列表。"""
+    raw = _norm(path)
+    if not raw:
+        return []
+    target = Path(raw)
+    try:
+        if target.is_file():
+            return []
+        if target.is_dir():
+            root = target
+        else:
+            root = _nearest_existing_dir(target)
+        if root is None:
+            return []
+        pat = pattern_for(raw, pattern)
+        hits = _collect(root, pat)
+    except OSError:
+        return []
+    wanted = target.name.lower()
+    hits.sort(key=lambda h: (os.path.basename(h).lower() != wanted, len(h), h.lower()))
+    unique: list[str] = []
+    seen: set[str] = set()
+    for hit in hits:
+        key = os.path.normcase(hit)
+        if key in seen:
+            continue
+        seen.add(key)
+        unique.append(hit)
+        if len(unique) >= max_hits:
+            break
+    return unique
+
+
+def path_hint(path: str, pattern: str | None = None) -> str:
+    """给"文件不存在"的报错追加一行候选提示（无候选时给定位建议）。"""
+    raw = _norm(path)
+    pat = pattern_for(raw, pattern)
+    candidates = suggest_paths(raw, pattern)
+    if candidates:
+        shown = "；".join(candidates)
+        return f"；附近找到候选（请用真实路径重试）: {shown}"
+    return (
+        f"；附近未找到匹配 {pat} 的文件：先确认工程根/产物目录"
+        "（可用 kit 的 tools/find-project.ps1 或 glob 定位），不要继续猜路径"
+    )
+
+
+def missing_file_message(path: str, label: str, pattern: str | None = None) -> str:
+    """``<label> 不存在: <path>`` + 候选提示，供解析器抛 FileNotFoundError 用。"""
+    return f"{label}不存在: {path}" + path_hint(path, pattern)
