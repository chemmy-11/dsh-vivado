+def _port_family(port: str) -> str:
+    """端口名归一成「族」：c0_ddr4_dq[31] -> c0_ddr4_dq，gt_refclk_p 原样。"""
+    if not port:
+        return "(未命名端口)"
+    return _PORT_INDEX_RE.sub("", port) or port
+
+
+def _rule_breakdown(issues: list[LintIssue]) -> str:
+    """给一条规则生成「这么多条是从哪来的」聚合括注。
+
+    MISSING_IOSTANDARD 一次几百条时，端口族分布才是有效信息
+    （c0_ddr4_dq 64 / c0_ddr4_adr 21 ...）；条数少时直接点端口名。
+    """
+    ports = [i.port for i in issues if i.port]
+
+    if len(issues) >= _BREAKDOWN_MIN_ISSUES and ports:
+        counts: dict[str, int] = {}
+        for p in ports:
+            fam = _port_family(p)
+            counts[fam] = counts.get(fam, 0) + 1
+        ranked = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
+        shown = " / ".join(f"{fam} {n}" for fam, n in ranked[:_MAX_BREAKDOWN_LABELS])
+        if len(ranked) > _MAX_BREAKDOWN_LABELS:
+            shown += f" / …（共 {len(ranked)} 族）"
+        return f"（端口族：{shown}）"
+
+    if ports:
+        uniq = list(dict.fromkeys(ports))
+        shown = " / ".join(uniq[:_MAX_BREAKDOWN_LABELS])
+        if len(uniq) > _MAX_BREAKDOWN_LABELS:
+            shown += f" / …（共 {len(uniq)} 个端口）"
+        return f"（端口：{shown}）"
+
+    file_counts: dict[str, int] = {}
+    for issue in issues:
+        name = Path(issue.file).name
+        file_counts[name] = file_counts.get(name, 0) + 1
+    if len(file_counts) > 1:
+        ranked = sorted(file_counts.items(), key=lambda kv: (-kv[1], kv[0]))
+        shown = " / ".join(f"{n} {c}" for n, c in ranked[:_MAX_BREAKDOWN_LABELS])
+        return f"（文件：{shown}）"
+    return ""
+
