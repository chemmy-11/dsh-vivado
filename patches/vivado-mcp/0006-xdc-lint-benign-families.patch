+    ),
+    (
+        re.compile(r"^(?:c\d+_)?ddr\d*(?:_|$)|^mig(?:_|$)", re.IGNORECASE),
+        "MIG/DDR 引脚：IOSTANDARD 由 MIG 生成的 XDC 提供，顶层 XDC 只给 "
+        "PACKAGE_PIN 是既有约定",
+    ),
+]
+
