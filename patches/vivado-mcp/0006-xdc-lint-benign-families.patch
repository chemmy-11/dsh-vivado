+_BENIGN_FAMILIES: list[tuple[re.Pattern[str], str]] = [
+    (
+        re.compile(r"^(?:mgtrefclk|gt.*refclk)", re.IGNORECASE),
+        "GT 参考时钟：MGTREFCLK 专用引脚由 GT 原语内部约束，不需要 IOSTANDARD"
