+def _benign_reason(
+    rule: str,
+    port: str,
+    allowlist: list[str] | None = None,
+) -> str:
+    """判断一条问题是否「已知良性」，返回良性理由（空串 = 不良性、要修）。
+
+    只对 ``MISSING_IOSTANDARD`` 生效：GT 参考时钟按 MGTREFCLK 用法不需要
+    IOSTANDARD（PITFALLS #20），MIG/DDR4 引脚的 IOSTANDARD 由 MIG 生成的
+    约束提供 —— 顶层 XDC 重复写反而会和 MIG 冲突。其它规则一律返回空串，
+    严重度与阻断判定不受端口名影响。
+
+    Args:
+        rule: 规则名。
+        port: 涉及端口（``c0_ddr4_dq[31]`` 这类带下标的会给归一成族）。
+        allowlist: 调用方追加的端口族 / glob 模式（如 ``c0_ddr4_*``、
+            ``gt_refclk_*``），命中同样标良性；大小写不敏感，可匹配原始端口
+            名（``led[0]``）或归一后的族名（``c0_ddr4_dq``）。
+    """
+    if rule != "MISSING_IOSTANDARD" or not port:
+        return ""
+    family = _port_family(port)
+    for pattern, reason in _BENIGN_FAMILIES:
+        if pattern.match(family):
+            return reason
+    for raw in allowlist or ():
+        pattern = str(raw).strip()
+        if not pattern:
+            continue
+        # glob 匹配原始端口名与归一后的族名两条路：调用方写 led[0] 或 led[*] 都能中
+        if _glob_match(pattern.lower(), port.lower()) or _glob_match(
+            pattern.lower(), family.lower()
+        ):
+            return f"调用方 benign_allowlist 命中 {pattern}（端口族 {family}）"
+    return ""
+
