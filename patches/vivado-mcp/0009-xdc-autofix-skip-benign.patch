+# 端口名末尾的总线下标：c0_ddr4_dq[31] -> c0_ddr4_dq（与 xdc_linter 同一口径）
+_PORT_INDEX_RE = re.compile(r"\[\d+(?::\d+)?\]$")
+
+
+def _port_family(port: str) -> str:
+    """端口名归一成「族」，供「已知良性已跳过」按族聚合。"""
+    if not port:
+        return "(未命名端口)"
+    return _PORT_INDEX_RE.sub("", port) or port
+
+
+def _is_benign(issue: LintIssue) -> bool:
+    """issue 是否被 xdc_linter 标为「已知良性」(GT 参考时钟 / MIG-DDR 引脚)。
+
+    用 getattr 读取:良性族标注在 xdc_linter 侧(可选补丁)。单独应用本补丁、
+    LintIssue 还没有 benign 字段时,getattr 退回 False —— 行为与旧版一致,
+    不会因为缺字段直接抛 AttributeError。
+    """
+    return bool(getattr(issue, "benign", False))
+
