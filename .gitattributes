# Line endings.
#
# Our own sources (scripts, docs, templates, patches) are LF in the repository and in the
# working tree: the installers, the renderer and the unified diffs all assume LF.
* text=auto

*.ps1    text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.tmpl   text eol=lf
*.json   text eol=lf
*.patch  text eol=lf
*.svg    text eol=lf
*.txt    text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
NOTICE          text eol=lf
LICENSE         text eol=lf

# `skills/**` is VENDORED content: the six AMD skills are copied byte-for-byte from
# vivado-ai-extension (MIT) so the NOTICE's "unmodified apart from 7 listed files" claim stays
# verifiable. Every upstream file is already LF, so pinning the checkout to LF keeps those bytes
# identical AND keeps `tools/gen_skills_manifest.py --check` (which hashes SKILL.md bytes) stable
# on any platform. Do not let a Windows checkout rewrite them to CRLF.
skills/**  text eol=lf

# Nothing binary is expected today; keep this explicit so a future asset does not get mangled.
*.png    binary
*.jpg    binary
*.ico    binary
*.zip    binary
